# Entorno del backend: development | staging | production
APP_ENV=development
NODE_ENV=development
PROCESS_ROLE=all

# Host de escucha. Desarrollo conserva loopback por defecto.
HOST=127.0.0.1
PORT=4000

# Orígenes exactos separados por coma; no usar * con cookies.
CLIENT_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY_HOPS=0

# Credencial privada API Mercado Público (no usar en el frontend)
MERCADOPUBLICO_TICKET=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=oportuna
DB_SSL=false
DB_SSL_MODE=VERIFY_IDENTITY
DB_SSL_CA=
DB_SSL_CA_SHA256=
# Excepción temporal solo para el staging SharkASP de Liciapp; nunca activar por defecto.
# DB_SSL_SHARKASP_COMPAT=true

# Token para autorizar POST /api/sync/licitaciones (mínimo 32 caracteres)
SYNC_API_TOKEN=
MERCADOPUBLICO_TIMEOUT_MS=15000
MERCADOPUBLICO_MIN_INTERVAL_MS=2000
MERCADOPUBLICO_MAX_RETRIES=3
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=12000

# Tareas desactivadas por defecto; flags solo se permiten en su rol dedicado.
SYNC_SCHEDULER_ENABLED=false
ENRICHMENT_WORKER_ENABLED=false
ALERT_SCHEDULER_ENABLED=false

# En staging/producción el rate limiting compartido está habilitado y requiere migrations/013_shared_rate_limits.sql.
RATE_LIMIT_SHARED=false
