{
  "name": "oportuna",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "typecheck": "npm run typecheck:server",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "start:server": "tsx server/src/index.ts",
    "start:server:compiled": "node dist-server/server/src/index.js",
    "auth:bootstrap": "tsx server/src/bootstrapAdmin.ts",
    "test": "npm run test:runtime && npm run test:matching && npm run test:search-relevance && npm run test:shared && npm run test:api-shared && npm run test:coordination && npm run test:auth && npm run test:qa",
    "test:runtime": "tsx server/test/runtimeConfig.unit.ts",
    "test:matching": "tsx server/test/commercialMatching.unit.ts",
    "test:commercial-intent": "tsx server/test/companyCommercialIntent.simulated.ts",
    "test:listing-status": "tsx server/test/listingStatus.unit.ts",
    "test:listing-analysis": "tsx server/test/listingAnalysis.local.ts",
    "test:company-catalog": "tsx server/test/companyCatalog.integration.ts",
    "test:search-relevance": "tsx server/test/searchRelevance.unit.ts",
    "test:search-readonly": "tsx server/scripts/validateLocalSearchReadonly.ts",
    "test:match-fixtures": "tsx server/scripts/validateCompanyMatchFixtures.ts",
    "diagnose:food-matches": "tsx server/scripts/diagnoseFoodCatalogMatches.ts",
    "diagnose:match-multirubro": "tsx server/scripts/benchmarkCompanyMatchesMultirubro.ts",
    "test:shared": "tsx server/test/rateLimits.integration.ts",
    "test:api-shared": "tsx server/test/rateLimitApi.integration.ts",
    "test:coordination": "tsx server/test/coordination.integration.ts",
    "test:auth": "tsx server/test/auth.integration.ts",
    "test:email-service": "tsx server/test/emailService.unit.ts",
    "test:email-failure-local": "tsx server/test/emailFailure.local.integration.ts",
    "test:launchd-config": "python3 server/test/launchdConfig.unit.py && bash -n scripts/launchd/oportuna-sync-worker && node --check scripts/launchd/supervise-sync-worker.mjs && node --check scripts/launchd/check-sync-idle.mjs && node --check scripts/launchd/show-sync-status.mjs",
    "test:qa": "tsx server/test/qa.integration.ts",
    "test:sync-simulated": "tsx server/test/syncDaily.simulated.ts",
    "test:sync-failure-simulated": "tsx server/test/syncDailyFailure.simulated.ts",
    "test:sync-scheduler": "tsx server/test/syncScheduler.unit.ts",
    "test:sync-scheduler-concurrency": "tsx server/test/syncScheduler.concurrent.simulated.ts",
    "test:enrichment-preview": "tsx server/test/enrichmentPreview.simulated.ts",
    "test:enrichment-index": "tsx server/test/enrichmentIndex.simulated.ts",
    "test:enrichment-recovery": "tsx server/test/enrichmentQueueRecovery.simulated.ts",
    "test:enrichment-safety": "npm run test:enrichment-evidence && npm run test:enrichment-preview && npm run test:enrichment-index && npm run test:enrichment-recovery",
    "test:enrichment-evidence": "tsx server/test/enrichmentEvidence.unit.ts",
    "test:mp-transport": "tsx server/test/mercadoPublicoTransport.unit.ts",
    "test:commercial-intent-pilot": "tsx server/test/commercialIntentPilotRegression.local.ts",
    "test:chilean-rut": "tsx server/test/chileanRut.unit.ts",
    "test:script-targets": "node server/test/packageScripts.unit.mjs",
    "test:ci": "npm run test:script-targets && npm run test:runtime && npm run test:matching && npm run test:search-relevance && npm run test:chilean-rut && npm run test:listing-status && npm run test:email-service && npm run test:enrichment-evidence && npm run test:mp-transport",
    "test:saas-onboarding": "npm run test:onboarding:playwright",
    "test:onboarding:playwright": "tsx server/test/onboarding.playwright.ts",
    "test:email:playwright": "tsx server/test/emailAccess.playwright.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
