{
  "name": "oportuna",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && npm run build:server && vite build",
    "build:sharkasp": "npm run build && node scripts/prepareSharkaspDeployRoot.mjs",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/buildSharkaspRuntimeVendors.mjs",
    "start": "node dist-server/server/src/index.js",
    "typecheck": "npm run typecheck:server",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "start:server": "tsx server/src/index.ts",
    "start:server:compiled": "node dist-server/server/src/index.js",
    "smoke:sharkasp": "node scripts/sharkaspSmoke.mjs",
    "auth:bootstrap": "tsx server/src/bootstrapAdmin.ts",
    "test": "npm run test:runtime && npm run test:matching && npm run test:search-relevance && npm run test:shared && npm run test:api-shared && npm run test:coordination && npm run test:auth && npm run test:qa",
    "test:runtime": "tsx server/test/runtimeConfig.unit.ts",
    "test:mysql-diagnostics": "tsx server/test/mysqlDiagnostics.unit.ts",
    "test:sharkasp-runtime-config": "node server/test/sharkaspRuntimeConfig.unit.mjs",
    "test:sharkasp-staging-config": "node server/test/sharkaspStagingPackage.unit.mjs",
    "test:matching": "tsx server/test/commercialMatching.unit.ts",
    "test:company-matches": "tsx server/test/companyMatchProfileKeywords.simulated.ts && tsx server/test/companyMatchBatches.simulated.ts && tsx server/test/companyCommercialIntent.simulated.ts",
    "test:commercial-intent": "tsx server/test/companyCommercialIntent.simulated.ts",
    "test:commercial-decision": "node --import tsx server/test/commercialDecision.unit.ts",
    "test:analytics-filters": "node --import tsx server/test/analyticsFilters.unit.ts",
    "test:offer-economics": "node --import tsx src/offerEconomics.unit.ts",
    "test:offer-draft-validation": "node --import tsx server/test/offerDraftValidation.unit.ts",
    "test:offer-document-analysis": "node --import tsx server/test/offerDocumentAnalysis.unit.ts",
    "test:automation-conditions": "node --import tsx server/test/automationConditions.unit.ts",
    "test:listing-status": "tsx server/test/listingStatus.unit.ts",
    "test:listing-analysis": "tsx server/test/listingAnalysis.local.ts",
    "test:company-catalog": "tsx server/test/companyCatalog.integration.ts",
    "test:search-relevance": "tsx server/test/searchRelevance.unit.ts",
    "test:search-readonly": "tsx server/scripts/validateLocalSearchReadonly.ts",
    "test:match-fixtures": "tsx server/scripts/validateCompanyMatchFixtures.ts",
    "diagnose:food-matches": "tsx server/scripts/diagnoseFoodCatalogMatches.ts",
    "diagnose:match-multirubro": "tsx server/scripts/benchmarkCompanyMatchesMultirubro.ts",
    "test:shared": "tsx server/test/rateLimits.integration.ts",
    "test:api-shared": "tsx server/test/rateLimitApi.integration.ts",
    "test:coordination": "tsx server/test/coordination.integration.ts",
    "test:auth": "tsx server/test/auth.integration.ts",
    "test:email-service": "tsx server/test/emailService.unit.ts",
    "test:smtp-startup-probe": "tsx server/test/smtpStartupProbe.unit.ts",
    "test:railpack-runtime": "node server/test/railpackRuntime.integration.mjs",
    "test:iis-runtime": "node server/test/iisRuntime.integration.mjs",
    "test:sharkasp-smoke": "node server/test/sharkaspSmoke.unit.mjs",
    "test:sharkasp-artifact": "node server/test/sharkaspDeployArtifact.unit.mjs",
    "test:email-failure-local": "tsx server/test/emailFailure.local.integration.ts",
    "test:launchd-config": "python3 server/test/launchdConfig.unit.py && bash -n scripts/launchd/oportuna-sync-worker && node --check scripts/launchd/supervise-sync-worker.mjs && node --check scripts/launchd/check-sync-idle.mjs && node --check scripts/launchd/show-sync-status.mjs",
    "test:qa": "tsx server/test/qa.integration.ts",
    "test:sync-simulated": "tsx server/test/syncDaily.simulated.ts",
    "test:sync-failure-simulated": "tsx server/test/syncDailyFailure.simulated.ts",
    "test:sync-scheduler": "tsx server/test/syncScheduler.unit.ts",
    "test:sync-scheduler-concurrency": "tsx server/test/syncScheduler.concurrent.simulated.ts",
    "test:enrichment-preview": "tsx server/test/enrichmentPreview.simulated.ts",
    "test:enrichment-index": "tsx server/test/enrichmentIndex.simulated.ts",
    "test:enrichment-recovery": "tsx server/test/enrichmentQueueRecovery.simulated.ts",
    "test:enrichment-safety": "npm run test:enrichment-evidence && npm run test:enrichment-preview && npm run test:enrichment-index && npm run test:enrichment-recovery",
    "test:enrichment-evidence": "tsx server/test/enrichmentEvidence.unit.ts",
    "test:mp-transport": "tsx server/test/mercadoPublicoTransport.unit.ts",
    "test:tender-amounts": "tsx server/test/tenderAmount.unit.ts",
    "test:tender-amounts:mysql": "tsx server/test/tenderAmount.mysql.integration.ts",
    "test:commercial-intent-pilot": "tsx server/test/commercialIntentPilotRegression.local.ts",
    "test:chilean-rut": "tsx server/test/chileanRut.unit.ts",
    "test:script-targets": "node server/test/packageScripts.unit.mjs",
    "test:ci": "npm run test:script-targets && npm run test:runtime && npm run test:mysql-diagnostics && npm run test:sharkasp-runtime-config && npm run test:sharkasp-staging-config && npm run test:matching && npm run test:search-relevance && npm run test:analytics-filters && npm run test:chilean-rut && npm run test:listing-status && npm run test:email-service && npm run test:smtp-startup-probe && npm run test:enrichment-evidence && npm run test:mp-transport && npm run test:tender-amounts && npm run test:automation-conditions && npm run test:offer-document-analysis && npm run test:sharkasp-smoke",
    "test:saas-onboarding": "npm run test:onboarding:playwright",
    "test:onboarding:playwright": "tsx server/test/onboarding.playwright.ts",
    "test:email:playwright": "tsx server/test/emailAccess.playwright.ts",
    "test:auth-lifecycle": "tsx server/test/authLifecycle.local.integration.ts",
    "test:company-profile-validation": "tsx server/test/companyProfileValidation.local.integration.ts",
    "test:company-profile:playwright": "tsx server/test/companyProfile.playwright.ts",
    "test:subscriptions:local": "tsx server/test/subscriptions.local.integration.ts",
    "test:subscriptions:api:local": "tsx server/test/subscriptions.api.local.integration.ts",
    "test:plan-requests:api:local": "tsx server/test/planChangeRequests.api.local.integration.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
