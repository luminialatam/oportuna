<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Staging web only: no scheduler or background worker in this process. -->
        <handlers>
            <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
        </handlers>
        <httpPlatform processPath="node" arguments="sharkasp-bootstrap.mjs" startupTimeLimit="60" startupRetryCount="2" processesPerApplication="1" forwardWindowsAuthToken="false" stdoutLogEnabled="false">
            <environmentVariables>
                <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
                <environmentVariable name="HOST" value="127.0.0.1" />
                <environmentVariable name="APP_ENV" value="staging" />
                <environmentVariable name="NODE_ENV" value="production" />
                <environmentVariable name="PROCESS_ROLE" value="web" />
                <environmentVariable name="SYNC_SCHEDULER_ENABLED" value="false" />
                <environmentVariable name="ENRICHMENT_WORKER_ENABLED" value="false" />
                <environmentVariable name="ALERT_SCHEDULER_ENABLED" value="false" />
                <environmentVariable name="RATE_LIMIT_SHARED" value="true" />
            </environmentVariables>
        </httpPlatform>
    </system.webServer>
</configuration>
